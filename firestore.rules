rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.get('email', '') == 'dailywage172@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }

    function isWorker(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/userProfiles/$(uid);
    }

    function walletPath(uid) {
      return /databases/$(database)/documents/rewardWallets/$(uid);
    }

    function deviceClaimPath(deviceId) {
      return /databases/$(database)/documents/deviceCheckInClaims/$(deviceId);
    }

    function withdrawalPath(requestId) {
      return /databases/$(database)/documents/withdrawalRequests/$(requestId);
    }

    function referralPath(inviteeUid) {
      return /databases/$(database)/documents/referralClaims/$(inviteeUid);
    }

    // Reward days and once-per-day withdrawal limits use Thailand local calendar days.
    function bangkokDayNumber(value) {
      return (value + duration.value(7, 'h')).date().toMillis();
    }

    function validProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'uid', 'fullName', 'dateOfBirth', 'country', 'gender', 'phone', 'email',
          'consentVersion', 'source', 'createdAt', 'consentedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'fullName', 'dateOfBirth', 'country', 'gender', 'phone', 'email',
          'consentVersion', 'source', 'createdAt', 'consentedAt', 'updatedAt', 'referredByUid'
        ])
        && data.uid == uid
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120
        && data.dateOfBirth is string && data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.country is string && data.country.size() > 0 && data.country.size() <= 100
        && data.gender in ['female', 'male', 'non_binary', 'prefer_not_to_say']
        && data.phone is string && data.phone.size() <= 30
        && data.email is string && data.email.size() <= 160
        && data.consentVersion == 1
        && data.source == 'daily-wage-app/Home'
        && (!data.keys().hasAny(['referredByUid'])
          || (data.referredByUid is string
            && data.referredByUid.matches('^[A-Za-z0-9]{28}$')
            && data.referredByUid != uid
            && exists(profilePath(data.referredByUid))))
        && data.createdAt is timestamp
        && data.consentedAt is timestamp
        && data.updatedAt == request.time;
    }

    function validWalletShape(data, uid) {
      return data.keys().hasAll([
          'uid', 'pointsBalance', 'streakCount', 'lastCheckInAt', 'lastWithdrawalAt',
          'lastWithdrawalRequestId', 'lastRefundRequestId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'pointsBalance', 'streakCount', 'lastCheckInAt', 'lastCheckInDeviceId', 'lastWithdrawalAt',
          'lastWithdrawalRequestId', 'lastRefundRequestId', 'createdAt', 'updatedAt',
          'totalCheckIns', 'completedSevenDayCycles', 'lastFreePassAt',
          'lastReferralClaimId', 'lastReferralClaimAt', 'lastSevenDayCycleAt'
        ])
        && data.uid == uid
        && data.pointsBalance is int && data.pointsBalance >= 0
        && data.streakCount is int && data.streakCount >= 0 && data.streakCount <= 6
        && data.get('totalCheckIns', 0) is int && data.get('totalCheckIns', 0) >= 0 && data.get('totalCheckIns', 0) <= 1000000000
        && data.get('completedSevenDayCycles', 0) is int && data.get('completedSevenDayCycles', 0) >= 0 && data.get('completedSevenDayCycles', 0) <= data.get('totalCheckIns', 0)
        && (data.lastCheckInAt == null || data.lastCheckInAt is timestamp)
        && (data.get('lastFreePassAt', null) == null || data.get('lastFreePassAt', null) is timestamp)
        && (data.get('lastReferralClaimId', null) == null
          || (data.get('lastReferralClaimId', '') is string
            && data.get('lastReferralClaimId', '').matches('^[A-Za-z0-9]{1,128}$')))
        && (data.get('lastReferralClaimAt', null) == null || data.get('lastReferralClaimAt', null) is timestamp)
        && (data.get('lastSevenDayCycleAt', null) == null || data.get('lastSevenDayCycleAt', null) is timestamp)
        && (data.lastWithdrawalAt == null || data.lastWithdrawalAt is timestamp)
        && (data.get('lastCheckInDeviceId', null) == null
          || (data.get('lastCheckInDeviceId', '') is string
            && data.get('lastCheckInDeviceId', '').matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')))
        && (data.lastWithdrawalRequestId == null || data.lastWithdrawalRequestId is string)
        && (data.lastRefundRequestId == null || data.lastRefundRequestId is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validInitialWallet(uid) {
      let data = request.resource.data;
      return validWalletShape(data, uid)
        && data.pointsBalance == 0
        && data.streakCount == 0
        && data.get('totalCheckIns', 0) == 0
        && data.get('completedSevenDayCycles', 0) == 0
        && data.lastCheckInAt == null
        && data.get('lastCheckInDeviceId', null) == null
        && data.get('lastFreePassAt', null) == null
        && data.get('lastReferralClaimId', null) == null
        && data.get('lastReferralClaimAt', null) == null
        && data.get('lastSevenDayCycleAt', null) == null
        && data.lastWithdrawalAt == null
        && data.lastWithdrawalRequestId == null
        && data.lastRefundRequestId == null
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function checkInState(before) {
      let gap = before.lastCheckInAt == null
        ? 0
        : bangkokDayNumber(request.time) - bangkokDayNumber(before.lastCheckInAt);
      let lastUsed = before.get('lastFreePassAt', null);
      let passReady = lastUsed == null || request.time >= lastUsed + duration.value(30, 'd');
      let passUsed = before.lastCheckInAt != null && gap == 172800000 && before.streakCount > 0 && passReady;
      return {
        'gap': gap,
        'passUsed': passUsed,
        'nextStreak': before.lastCheckInAt == null || (gap > 86400000 && !passUsed) ? 1 : before.streakCount + 1
      };
    }

    function validCheckInWalletUpdate(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let deviceId = after.get('lastCheckInDeviceId', 'invalid-device-id');
      let claim = deviceClaimPath(deviceId);
      let deviceClaim = getAfter(claim).data;
      let firstCheckIn = before.lastCheckInAt == null;
      let state = checkInState(before);
      let nextStreak = state.nextStreak;
      let completesCycle = nextStreak == 7;
      let passUsed = state.passUsed;
      return validWalletShape(after, uid)
        && after.diff(before).affectedKeys().hasOnly([
          'pointsBalance', 'streakCount', 'lastCheckInAt', 'lastCheckInDeviceId', 'lastFreePassAt',
          'totalCheckIns', 'completedSevenDayCycles', 'lastSevenDayCycleAt', 'updatedAt'
        ])
        && (firstCheckIn || state.gap > 0)
        && after.pointsBalance == before.pointsBalance + (completesCycle ? 400 : 100)
        && after.streakCount == (completesCycle ? 0 : nextStreak)
        && after.totalCheckIns == before.get('totalCheckIns', 0) + 1
        && after.completedSevenDayCycles == before.get('completedSevenDayCycles', 0) + (completesCycle ? 1 : 0)
        && after.get('lastSevenDayCycleAt', null) == (completesCycle ? request.time : before.get('lastSevenDayCycleAt', null))
        && after.lastFreePassAt == (passUsed ? request.time : before.get('lastFreePassAt', null))
        && after.lastCheckInAt == request.time
        && deviceId is string
        && deviceId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && existsAfter(claim)
        && deviceClaim.uid == uid
        && deviceClaim.deviceId == deviceId
        && deviceClaim.dayNumber == bangkokDayNumber(request.time)
        && after.lastWithdrawalAt == before.lastWithdrawalAt
        && after.lastWithdrawalRequestId == before.lastWithdrawalRequestId
        && after.lastRefundRequestId == before.lastRefundRequestId
        && after.createdAt == before.createdAt
        && after.updatedAt == request.time;
    }

    function validReferralClaimCreate(inviteeUid) {
      let data = request.resource.data;
      let inviterUid = data.get('inviterUid', '');
      return isWorker(inviteeUid)
        && data.keys().hasAll(['inviteeUid', 'inviterUid', 'status', 'rewardPoints', 'createdAt', 'updatedAt', 'awardedAt'])
        && data.keys().hasOnly(['inviteeUid', 'inviterUid', 'status', 'rewardPoints', 'createdAt', 'updatedAt', 'awardedAt'])
        && data.inviteeUid == inviteeUid
        && inviterUid is string && inviterUid != inviteeUid
        && inviterUid.matches('^[A-Za-z0-9]{28}$')
        && exists(profilePath(inviteeUid))
        && get(profilePath(inviteeUid)).data.get('referredByUid', null) == inviterUid
        && exists(profilePath(inviterUid))
        && exists(walletPath(inviterUid))
        && data.status == 'pending' && data.rewardPoints == 100
        && data.createdAt == request.time && data.updatedAt == request.time && data.awardedAt == null
        && data.inviteeUid == inviteeUid;
    }

    function validReferralInviteeAward(inviteeUid) {
      let before = resource.data;
      let after = request.resource.data;
      let inviterUid = before.inviterUid;
      let inviteeBefore = get(walletPath(inviteeUid)).data;
      let inviteeAfter = getAfter(walletPath(inviteeUid)).data;
      return isWorker(inviteeUid)
        && before.status == 'pending' && after.status == 'invitee_awarded'
        && before.inviteeUid == inviteeUid && before.inviterUid == inviterUid
        && before.rewardPoints == 100 && after.rewardPoints == before.rewardPoints
        && after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt', 'awardedAt'])
        && after.createdAt == before.createdAt
        && after.updatedAt == request.time && after.awardedAt == request.time
        && get(profilePath(inviteeUid)).data.get('referredByUid', null) == inviterUid
        && inviterUid != inviteeUid
        && inviteeBefore.get('completedSevenDayCycles', 0) > 0
        && inviteeBefore.get('lastSevenDayCycleAt', null) is timestamp
        && inviteeBefore.lastCheckInAt is timestamp
        && inviteeAfter.pointsBalance == inviteeBefore.pointsBalance + 100
        && inviteeAfter.updatedAt == request.time;
    }

    function validInviteeReferralWalletUpdate(uid) {
      let claim = referralPath(uid);
      return isWorker(uid)
        && exists(claim)
        && validInviteeReferralWalletUpdateWithClaim(uid, claim);
    }

    function validInviteeReferralWalletUpdateWithClaim(uid, claim) {
      let before = resource.data;
      let after = request.resource.data;
      let referralBefore = get(claim).data;
      let referralAfter = getAfter(claim).data;
      return referralBefore.inviteeUid == uid
        && referralBefore.status == 'pending'
        && referralAfter.status == 'invitee_awarded'
        && get(profilePath(uid)).data.get('referredByUid', null) == referralBefore.inviterUid
        && before.get('completedSevenDayCycles', 0) > 0
        && before.get('lastSevenDayCycleAt', null) is timestamp
        && before.lastCheckInAt is timestamp
        && after.diff(before).affectedKeys().hasOnly(['pointsBalance', 'updatedAt'])
        && after.pointsBalance == before.pointsBalance + 100
        && after.updatedAt == request.time;
    }

    function validReferralInviterWalletUpdate(inviterUid) {
      let after = request.resource.data;
      let inviteeUid = after.get('lastReferralClaimId', 'invalid-referral-claim');
      let claim = referralPath(inviteeUid);
      return isWorker(inviterUid)
        && inviteeUid is string
        && inviteeUid.matches('^[A-Za-z0-9]{1,128}$')
        && exists(claim)
        && validReferralInviterWalletUpdateWithClaim(inviterUid, inviteeUid, claim);
    }

    function validReferralInviterWalletUpdateWithClaim(inviterUid, inviteeUid, claim) {
      let before = resource.data;
      let after = request.resource.data;
      let referralBefore = get(claim).data;
      let referralAfter = getAfter(claim).data;
      return isWorker(inviterUid)
        && validWalletShape(after, inviterUid)
        && referralBefore.inviterUid == inviterUid
        && referralBefore.status == 'invitee_awarded'
        && referralAfter.status == 'awarded'
        && after.diff(before).affectedKeys().hasOnly(['pointsBalance', 'lastReferralClaimId', 'lastReferralClaimAt', 'updatedAt'])
        && after.pointsBalance == before.pointsBalance + 100
        && after.lastReferralClaimId == inviteeUid
        && after.lastReferralClaimAt == request.time
        && after.updatedAt == request.time;
    }

    function validReferralInviterClaim(inviteeUid) {
      let before = resource.data;
      let after = request.resource.data;
      let inviterUid = before.inviterUid;
      let walletBefore = get(walletPath(inviterUid)).data;
      let walletAfter = getAfter(walletPath(inviterUid)).data;
      return isWorker(inviterUid)
        && before.status == 'invitee_awarded' && after.status == 'awarded'
        && before.inviteeUid == inviteeUid && before.inviterUid == inviterUid
        && before.rewardPoints == 100 && after.rewardPoints == before.rewardPoints
        && after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt', 'awardedAt'])
        && after.createdAt == before.createdAt
        && after.updatedAt == request.time && after.awardedAt == request.time
        && walletAfter.pointsBalance == walletBefore.pointsBalance + 100
        && walletAfter.lastReferralClaimId == inviteeUid
        && walletAfter.lastReferralClaimAt == request.time
        && walletAfter.updatedAt == request.time;
    }

    function validReferralClaimUpdate(inviteeUid) {
      return validReferralInviteeAward(inviteeUid) || validReferralInviterClaim(inviteeUid);
    }

    function validDeviceClaimCreate(deviceId) {
      let data = request.resource.data;
      let uid = data.get('uid', '');
      let requestedDeviceId = data.get('deviceId', '');
      let dayNumber = data.get('dayNumber', 0);
      return data.keys().hasAll(['uid', 'deviceId', 'dayNumber', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'deviceId', 'dayNumber', 'createdAt', 'updatedAt'])
        && isWorker(uid)
        && requestedDeviceId == deviceId
        && requestedDeviceId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && dayNumber is int && dayNumber == bangkokDayNumber(request.time)
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && existsAfter(walletPath(uid))
        && getAfter(walletPath(uid)).data.uid == uid
        && getAfter(walletPath(uid)).data.lastCheckInAt == request.time
        && getAfter(walletPath(uid)).data.lastCheckInDeviceId == requestedDeviceId;
    }

    function validDeviceClaimUpdate(deviceId) {
      let before = resource.data;
      let after = request.resource.data;
      let uid = after.get('uid', '');
      let requestedDeviceId = after.get('deviceId', '');
      let dayNumber = after.get('dayNumber', 0);
      return after.keys().hasAll(['uid', 'deviceId', 'dayNumber', 'createdAt', 'updatedAt'])
        && after.keys().hasOnly(['uid', 'deviceId', 'dayNumber', 'createdAt', 'updatedAt'])
        && isWorker(uid)
        && before.deviceId == deviceId
        && before.dayNumber is int && before.dayNumber < dayNumber
        && requestedDeviceId == deviceId
        && requestedDeviceId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && dayNumber is int && dayNumber == bangkokDayNumber(request.time)
        && after.createdAt == before.createdAt
        && after.updatedAt == request.time
        && existsAfter(walletPath(uid))
        && getAfter(walletPath(uid)).data.uid == uid
        && getAfter(walletPath(uid)).data.lastCheckInAt == request.time
        && getAfter(walletPath(uid)).data.lastCheckInDeviceId == requestedDeviceId;
    }

    function validWithdrawalWalletUpdate(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let requestId = after.lastWithdrawalRequestId;
      return validWalletShape(after, uid)
        && requestId is string
        && requestId.size() > 0
        && existsAfter(withdrawalPath(requestId))
        && after.diff(before).affectedKeys().hasOnly([
          'pointsBalance', 'lastWithdrawalAt', 'lastWithdrawalRequestId', 'updatedAt'
        ])
        && after.pointsBalance == before.pointsBalance
          - getAfter(withdrawalPath(requestId)).data.pointsRequested
        && after.lastCheckInAt == before.lastCheckInAt
        && after.streakCount == before.streakCount
        && after.lastWithdrawalAt == request.time
        && after.lastWithdrawalRequestId != before.lastWithdrawalRequestId
        && after.lastRefundRequestId == before.lastRefundRequestId
        && after.createdAt == before.createdAt
        && after.updatedAt == request.time
        && (before.lastWithdrawalAt == null
          || bangkokDayNumber(request.time) > bangkokDayNumber(before.lastWithdrawalAt))
        && getAfter(withdrawalPath(requestId)).data.uid == uid
        && getAfter(withdrawalPath(requestId)).data.requestId == requestId
        && getAfter(withdrawalPath(requestId)).data.status == 'pending'
        && getAfter(withdrawalPath(requestId)).data.pointsRequested is int;
    }

    function validRefundWalletUpdate(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let requestId = after.lastRefundRequestId;
      return requestId is string
        && requestId.size() > 0
        && exists(withdrawalPath(requestId))
        && existsAfter(withdrawalPath(requestId))
        && after.diff(before).affectedKeys().hasOnly([
          'pointsBalance', 'lastRefundRequestId', 'updatedAt'
        ])
        && after.pointsBalance == before.pointsBalance
          + get(withdrawalPath(requestId)).data.pointsRequested
        && after.lastRefundRequestId == requestId
        && after.updatedAt == request.time
        && after.uid == before.uid
        && after.streakCount == before.streakCount
        && after.lastCheckInAt == before.lastCheckInAt
        && after.lastWithdrawalAt == before.lastWithdrawalAt
        && after.lastWithdrawalRequestId == before.lastWithdrawalRequestId
        && after.createdAt == before.createdAt
        && get(withdrawalPath(requestId)).data.uid == uid
        && get(withdrawalPath(requestId)).data.status in ['pending', 'processing']
        && get(withdrawalPath(requestId)).data.refunded == false
        && getAfter(withdrawalPath(requestId)).data.status == 'rejected'
        && getAfter(withdrawalPath(requestId)).data.refunded == true;
    }

    function validWithdrawalRequest(uid, requestId) {
      let data = request.resource.data;
      let walletBefore = get(walletPath(uid)).data;
      let walletAfter = getAfter(walletPath(uid)).data;
      return data.keys().hasAll([
          'requestId', 'uid', 'userFullName', 'pointsRequested', 'amountBaht', 'currency',
          'walletProvider', 'walletAccountName', 'walletAccountNumber', 'status', 'refunded',
          'adminNote', 'consentVersion', 'consentedAt', 'createdAt', 'updatedAt',
          'reviewedAt', 'processedAt', 'rejectedAt'
        ])
        && data.keys().hasOnly([
          'requestId', 'uid', 'userFullName', 'pointsRequested', 'amountBaht', 'currency',
          'walletProvider', 'walletAccountName', 'walletAccountNumber', 'status', 'refunded',
          'adminNote', 'consentVersion', 'consentedAt', 'createdAt', 'updatedAt',
          'reviewedAt', 'processedAt', 'rejectedAt'
        ])
        && data.requestId == requestId
        && data.uid == uid
        && data.userFullName == get(profilePath(uid)).data.fullName
        && data.pointsRequested is int && data.pointsRequested >= 1000
        && data.amountBaht is int && data.amountBaht >= 10
        && data.pointsRequested == data.amountBaht * 100
        && data.currency == 'THB'
        && data.walletProvider == 'TrueMoney Wallet'
        && data.walletAccountName is string
        && data.walletAccountName.size() >= 2 && data.walletAccountName.size() <= 120
        && data.walletAccountNumber is string
        && data.walletAccountNumber.matches('^[0-9]{8,15}$')
        && data.status == 'pending'
        && data.refunded == false
        && data.adminNote == ''
        && data.consentVersion == 1
        && data.consentedAt == request.time
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.reviewedAt == null
        && data.processedAt == null
        && data.rejectedAt == null
        && exists(profilePath(uid))
        && exists(walletPath(uid))
        && walletBefore.uid == uid
        && walletBefore.pointsBalance >= data.pointsRequested
        && (walletBefore.lastWithdrawalAt == null
          || bangkokDayNumber(request.time) > bangkokDayNumber(walletBefore.lastWithdrawalAt))
        && walletAfter.uid == uid
        && walletAfter.pointsBalance == walletBefore.pointsBalance - data.pointsRequested
        && walletAfter.lastWithdrawalAt == request.time
        && walletAfter.lastWithdrawalRequestId == requestId
        && walletAfter.updatedAt == request.time;
    }

    function validRejectedRequestRefund(uid, requestId) {
      let walletBefore = get(walletPath(uid)).data;
      let walletAfter = getAfter(walletPath(uid)).data;
      return exists(walletPath(uid))
        && existsAfter(walletPath(uid))
        && walletAfter.uid == uid
        && walletAfter.pointsBalance == walletBefore.pointsBalance + resource.data.pointsRequested
        && walletAfter.lastRefundRequestId == requestId
        && walletAfter.updatedAt == request.time;
    }

    function validAdminWithdrawalUpdate(requestId) {
      let before = resource.data;
      let after = request.resource.data;
      let toProcessing = before.status == 'pending' && after.status == 'processing';
      let toPaid = before.status == 'processing' && after.status == 'paid';
      let toRejected = before.status in ['pending', 'processing'] && after.status == 'rejected';
      return isAdmin()
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'refunded', 'adminNote', 'updatedAt', 'reviewedAt', 'processedAt', 'rejectedAt'
        ])
        && after.requestId == before.requestId
        && after.uid == before.uid
        && after.pointsRequested == before.pointsRequested
        && after.amountBaht == before.amountBaht
        && after.walletAccountNumber == before.walletAccountNumber
        && after.walletAccountName == before.walletAccountName
        && after.updatedAt == request.time
        && after.adminNote is string && after.adminNote.size() <= 500
        && (toProcessing
          ? after.refunded == false
            && after.reviewedAt == request.time
            && after.processedAt == before.processedAt
            && after.rejectedAt == before.rejectedAt
          : toPaid
            ? after.refunded == false
              && after.reviewedAt == before.reviewedAt
              && after.processedAt == request.time
              && after.rejectedAt == before.rejectedAt
            : toRejected
              ? after.refunded == true
                && after.adminNote.size() >= 3
                && after.reviewedAt == (before.reviewedAt == null ? request.time : before.reviewedAt)
                && after.processedAt == before.processedAt
                && after.rejectedAt == request.time
                && validRejectedRequestRefund(before.uid, requestId)
              : false);
    }

    match /userProfiles/{uid} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isWorker(uid)
        && validProfile(uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.consentedAt == request.time;
      allow update: if isWorker(uid)
        && validProfile(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.consentedAt == resource.data.consentedAt
        && request.resource.data.get('referredByUid', null) == resource.data.get('referredByUid', null);
      allow delete: if false;
    }

    match /rewardWallets/{uid} {
      allow get: if isAdmin() || isWorker(uid);
      allow list: if false;
      allow create: if isWorker(uid)
        && exists(profilePath(uid))
        && validInitialWallet(uid);
      allow update: if (isWorker(uid)
          && exists(profilePath(uid))
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pointsBalance', 'updatedAt'])
                && validInviteeReferralWalletUpdate(uid))
            || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastCheckInAt'])
                && validCheckInWalletUpdate(uid))
            || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastWithdrawalAt', 'lastWithdrawalRequestId'])
                && validWithdrawalWalletUpdate(uid))))
        || (isWorker(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastReferralClaimId'])
          && validReferralInviterWalletUpdate(uid))
        || (isAdmin() && validRefundWalletUpdate(uid));
      allow delete: if false;
    }

    match /deviceCheckInClaims/{deviceId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if validDeviceClaimCreate(deviceId);
      allow update: if validDeviceClaimUpdate(deviceId);
      allow delete: if false;
    }

    match /withdrawalRequests/{requestId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isWorker(request.resource.data.uid)
        && validWithdrawalRequest(request.resource.data.uid, requestId);
      allow update: if validAdminWithdrawalUpdate(requestId);
      allow delete: if false;
    }

    match /referralClaims/{inviteeUid} {
      allow get: if isAdmin() || (isSignedIn()
        && (inviteeUid == request.auth.uid || resource.data.inviterUid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn()
        && (resource.data.inviterUid == request.auth.uid || resource.data.inviteeUid == request.auth.uid));
      allow create: if validReferralClaimCreate(inviteeUid);
      allow update: if validReferralClaimUpdate(inviteeUid);
      allow delete: if false;
    }
  }
}
